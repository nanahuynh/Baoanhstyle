rules_version = '2';
// Dán toàn bộ file này vào Firebase Console → Firestore Database → Rules → Publish.
// Sửa danh sách email admin bên dưới cho giống ADMIN_EMAILS trong js/firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'email-cua-shop@gmail.com'
        ];
    }
    function signedIn() { return request.auth != null; }
    function order(id) { return get(/databases/$(database)/documents/orders/$(id)).data; }
    // the signed-in customer owns this order and it has been delivered
    function deliveredToMe(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && order(orderId).uid == request.auth.uid
        && order(orderId).status == 'done';
    }

    // Đơn hàng: ai cũng được TẠO đơn mới (kể cả khách không đăng nhập).
    // Khách đã đăng nhập xem được đơn của chính mình. Chỉ admin sửa/xóa.
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.stockApplied == false
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && (request.resource.data.uid == null
            || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Hồ sơ khách: tên, số điện thoại, sổ địa chỉ. Chỉ chính chủ (và admin xem).
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Đánh giá: ai cũng xem. Chỉ khách đã NHẬN HÀNG của đơn đó mới viết, mỗi món một lần (id = orderId_productId).
    match /reviews/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.orderId + '_' + request.resource.data.productId
        && deliveredToMe(request.resource.data.orderId)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1500;
      allow delete: if isAdmin();
    }

    // Đổi / trả: khách gửi yêu cầu cho đơn đã nhận của mình. Admin xử lý.
    match /returns/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'requested'
        && deliveredToMe(request.resource.data.orderId);
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    // Kho hàng và sổ vốn/chi phí: chỉ admin.
    match /inventory/{id} {
      allow read, write: if isAdmin();
    }
    match /ledger/{id} {
      allow read, write: if isAdmin();
    }
  }
}
