rules_version = '2';
// Dán toàn bộ file này vào Firebase Console → Firestore Database → Rules → Publish.
// Sửa danh sách email admin bên dưới cho giống ADMIN_EMAILS trong js/firebase-config.js.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'email-cua-shop@gmail.com'
        ];
    }

    // Đơn hàng: khách (kể cả không đăng nhập) chỉ được TẠO đơn mới.
    // Khách đã đăng nhập xem được đơn của chính mình. Admin xem/sửa tất cả.
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.stockApplied == false
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == null
            || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Kho hàng và sổ vốn/chi phí: chỉ admin.
    match /inventory/{id} {
      allow read, write: if isAdmin();
    }
    match /ledger/{id} {
      allow read, write: if isAdmin();
    }
  }
}
